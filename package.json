{
  "name": "order-report-legacy",
  "version": "1.0.0",
  "description": "Legacy order report system - Refactoring test",
  "main": "legacy/orderReportLegacy.ts",
  "scripts": {
    "legacy": "ts-node legacy/orderReportLegacy.ts",
    "refacto": "ts-node src/main.ts",
    "test": "jest --clearCache && jest",
    "test:watch": "jest --watch",
    "lint": "eslint . --ext .ts,.js",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.39",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.5.0",
    "jest": "^29.5.0",
    "jiti": "^2.6.1",
    "prettier": "^3.8.3",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.58.2"
  },
  "dependencies": {
    "csv-parse": "^6.2.1"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "tests",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
